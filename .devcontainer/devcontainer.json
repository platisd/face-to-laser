{
  "name": "face-to-laser",
  "build": {
    "dockerfile": "Dockerfile",
    "context": ".."
  },
  "features": {
    "ghcr.io/devcontainers/features/node:1": { "version": "22" }
  },
  "containerEnv": {
    "U2NET_HOME": "${containerWorkspaceFolder}/models/rembg"
  },
  "forwardPorts": [7860, 5173],
  "customizations": {
    "vscode": {
      "extensions": ["ms-python.python"]
    }
  }
}
